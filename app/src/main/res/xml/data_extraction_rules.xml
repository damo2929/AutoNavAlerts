<?xml version="1.0" encoding="utf-8"?>
<!-- PocketGPSWorld data must never leave the device (licence; DESIGN.md §6.4).
     The POI database and PGW credentials/cookies are excluded from cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="poi.db" />
        <exclude domain="database" path="poi.db-wal" />
        <exclude domain="database" path="poi.db-shm" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore" />
        <exclude domain="file" path="pgw" />
        <exclude domain="file" path="osm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="poi.db" />
        <exclude domain="database" path="poi.db-wal" />
        <exclude domain="database" path="poi.db-shm" />
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore" />
        <exclude domain="file" path="pgw" />
        <exclude domain="file" path="osm" />
    </device-transfer>
</data-extraction-rules>
